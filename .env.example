# Local API origin; do not place credentials or tokens in frontend environment variables.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Feature 009 scheduled execution. Keep true for a local/single-process backend.
# In a multi-worker deployment, enable this on exactly one designated process;
# set false on every additional API worker.
SCHEDULER_ENABLED=true

# Local development database. Set a random hexadecimal password in your ignored .env file.
POSTGRES_USER=repo_miner
POSTGRES_PASSWORD=
POSTGRES_DB=repo_miner_dev
POSTGRES_PORT=5432

# Generate a local Fernet key; never commit a usable key.
GITLAB_CREDENTIAL_ENCRYPTION_KEYS=
GITLAB_CONNECT_TIMEOUT_SECONDS=5
GITLAB_READ_TIMEOUT_SECONDS=10
GITLAB_WRITE_TIMEOUT_SECONDS=5
GITLAB_POOL_TIMEOUT_SECONDS=5

# Feature 011 on-demand commit diff response bounds; limits count UTF-8 diff text, not JSON metadata.
FINDING_DIFF_MAX_FILES=100
FINDING_DIFF_MAX_FILE_BYTES=262144
FINDING_DIFF_MAX_TOTAL_BYTES=2097152
FINDING_DIFF_MAX_PATH_BYTES=4096
